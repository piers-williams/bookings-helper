{
  "manifest_version": 3,
  "name": "Bookings Assistant",
  "version": "0.4.0",
  "description": "Annotates dates in OSM booking pages with weekday and school-holiday badges.",
  "host_permissions": [
    "https://www.onlinescoutmanager.co.uk/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.onlinescoutmanager.co.uk/*"],
      "js": ["content-osm.js"],
      "run_at": "document_idle"
    }
  ]
}
